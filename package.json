{
  "name": "manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --config src/client/vite.config.ts",
    "build": "vite build --config src/client/vite.config.ts && tsx src/server/build.ts",
    "start": "node dist-server/index.mjs",
    "preview": "pnpm run build && pnpm run start",
    "check": "pnpm run lint && pnpm run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:start": "docker-compose -f docker-compose.dev.yml up -d",
    "db:stop": "docker-compose -f docker-compose.dev.yml down",
    "db:restart": "docker-compose -f docker-compose.dev.yml down && docker-compose -f docker-compose.dev.yml up -d",
    "db:reset": "docker-compose -f docker-compose.dev.yml down -v",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/server/scripts/seed.ts",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.4.18",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.7.3",
    "@hookform/resolvers": "^3.10.0",
    "@internationalized/date": "^3.6.0",
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^0.0.34",
    "@stepperize/react": "^5.1.9",
    "@t3-oss/env-core": "^0.10.1",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.115.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/pg": "^8.11.11",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.0",
    "drizzle-zod": "^0.5.1",
    "fuse.js": "^7.1.0",
    "hono": "^4.9.8",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.0.4",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.554.0",
    "luxon": "^3.6.0",
    "motion": "^12.16.0",
    "nodemailer": "^6.10.0",
    "pg": "8.14.1",
    "postgres": "^3.4.4",
    "posthog-js": "^1.258.5",
    "react": "^18.3.1",
    "react-aria-components": "^1.5.0",
    "react-day-picker": "8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.1",
    "recharts": "^2.14.1",
    "redis": "^5.5.6",
    "sonner": "^2.0.7",
    "superjson": "^2.2.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "ua-parser-js": "^2.0.3",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.115.0",
    "@types/eslint": "^8.56.10",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "postcss": "^8.4.49",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
}
