# Authentication
AUTH_SECRET=""                              # Required

# Database (PostgreSQL)
POSTGRES_USER=""                            # Required
POSTGRES_PASSWORD=""                        # Required
POSTGRES_DB=""                              # Required
POSTGRES_HOST=""                            # Required
POSTGRES_PORT="5432"                        # Optional, defaults to 5432

# App
PUBLIC_APP_URL=""                           # Required, e.g. http://localhost:3000
NODE_ENV="development"                      # Optional: development | production
PUBLIC_ENVIRONMENT="development"            # Optional
PORT="3000"                                 # Optional, defaults to 3000

# Redis
REDIS_URL="redis://localhost:6379"          # Optional
# REDIS_KV_URL=""                            # Optional (Upstash)
# REDIS_KV_REST_API_READ_ONLY_TOKEN=""       # Optional
# REDIS_KV_REST_API_TOKEN=""                 # Optional
# REDIS_KV_REST_API_URL=""                   # Optional

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (email, optional)
RESEND_API_KEY=""
EMAIL_FROM=""                                # Optional, e.g. "Moneyger <noreply@moneyger.dev>"

# Exchange rate API (optional, https://www.exchangerate-api.com/)
EXCHANGE_RATE_API_KEY=""
EXCHANGE_RATE_URL="https://api.fxratesapi.com/"