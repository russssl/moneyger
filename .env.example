# Authentication
AUTH_SECRET=""                              # Required

# Database (PostgreSQL)
POSTGRES_USER=""                            # Required
POSTGRES_PASSWORD=""                        # Required
POSTGRES_DB=""                              # Required
POSTGRES_HOST=""                            # Required
POSTGRES_PORT="5432"                        # Optional, defaults to 5432

# App
PUBLIC_APP_URL=""                           # Required, e.g. http://localhost:3000
NODE_ENV="development"                      # Optional: development | production
PUBLIC_ENVIRONMENT="development"            # Optional
PORT="3000"                                 # Optional, defaults to 3000

# Redis
REDIS_URL="redis://localhost:6379"          # Optional
# REDIS_KV_URL=""                            # Optional (Upstash)
# REDIS_KV_REST_API_READ_ONLY_TOKEN=""       # Optional
# REDIS_KV_REST_API_TOKEN=""                 # Optional
# REDIS_KV_REST_API_URL=""                   # Optional

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (native SMTP via Proton/etc, optional)
EMAIL_FROM=""                                # Optional, e.g. "Moneyger <noreply@moneyger.dev>" — must exactly match SMTP_USER (e.g. Proton rejects 553 otherwise); if empty defaults to SMTP_USER
REQUIRES_EMAIL_CONFIRMATION="false"          # Optional, set to "true" to require email verification before account activation
EMAIL_VERIFICATION_EXPIRES_IN="3600"         # Optional, seconds until verification token expires (default 3600)

SMTP_HOST=""                                 # e.g. smtp.protonmail.ch
SMTP_PORT="587"                              # e.g. 587 (STARTTLS) or 465 (SSL)
SMTP_USER=""                                 # SMTP username (e.g. noreply@moneyger.dev) — must match EMAIL_FROM
SMTP_PASSWORD=""                             # SMTP password / app password
SMTP_SECURE="false"                          # true for 465 (SSL), false for 587 (STARTTLS)

# Exchange rate API (optional, https://www.exchangerate-api.com/)
EXCHANGE_RATE_API_KEY=""
EXCHANGE_RATE_URL="https://api.fxratesapi.com/"